<Window x:Class="ZenithOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZenithOptimizer"
        xmlns:vm="clr-namespace:ZenithOptimizer.ViewModels"
        xmlns:models="clr-namespace:ZenithOptimizer.Models"
        xmlns:services="clr-namespace:ZenithOptimizer.Services"
        mc:Ignorable="d"
        Title="Zenith Optimizer"
        Height="840" Width="1200"
        MinHeight="700" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppleFont}">

    <Window.Resources>
        <!-- Apple Card Style -->
        <Style x:Key="AppleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Metric Card Style -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Segmented Tab Navigation RadioButton Style -->
        <Style x:Key="SegmentedTabStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource SegmentedTabActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Risk Filter Pill Style -->
        <Style x:Key="RiskFilterPillStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppleFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SegmentedTabBgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Progress Bar Style -->
        <Style x:Key="MetricProgressStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource SegmentedTabBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="2"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Impact Smooth Purple Progress Bar Style -->
        <Style x:Key="SmoothPurpleProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource SegmentedTabBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#C084FC" Offset="0.0"/>
                                            <GradientStop Color="#9333EA" Offset="0.5"/>
                                            <GradientStop Color="#7C3AED" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Navigation -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Live Hardware Telemetry Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Active Tab Content Area -->
            <RowDefinition Height="*"/>
            <!-- 3: Busy / Progress Overlay -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER & BRANDING ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand & Logo -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Segmented Tab Navigation -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right Actions & Device Badge -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App Mark Icon (Crisp vector squircle with razor-sharp bold Z) -->
                    <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#9333EA" Offset="0.0"/>
                                <GradientStop Color="#6D28D9" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#C084FC" Opacity="0.5"/>
                        </Border.BorderBrush>
                        <Border BorderThickness="1" CornerRadius="9">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Z" 
                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" 
                                           FontWeight="Bold" 
                                           FontSize="20" 
                                           Foreground="#FFFFFF" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Margin="0,-1,0,0"
                                           TextOptions.TextRenderingMode="ClearType"
                                           TextOptions.TextFormattingMode="Display"/>
                            </Grid>
                        </Border>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Custom Wordmark Logo (e.g. Zenith. in purple) -->
                            <Image x:Name="CustomLogoImage"
                                   Height="24"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed"/>

                            <!-- Fallback Text Logo if no image -->
                            <TextBlock x:Name="BrandText" Text="ZENITH" FontWeight="Bold" FontSize="16" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <Border Background="{DynamicResource AccentBrushLight}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OPTIMIZER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Windows 10/11 Performance Suite" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 4 Unified Segmented Navigation Pills -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SegmentedTabBgBrush}"
                        CornerRadius="10"
                        Padding="3"
                        Margin="16,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Dashboard"
                                     GroupName="NavTabs"
                                     IsChecked="True"
                                     Tag="Dashboard"
                                     Click="TabButton_Click"
                                     Style="{StaticResource SegmentedTabStyle}"/>
                        <RadioButton Content="Tweaks"
                                     GroupName="NavTabs"
                                     Tag="Tweaks"
                                     Click="TabButton_Click"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     ToolTip="Unified tweaks auto-filtered for your Windows version"/>
                        <RadioButton Content="Debloat Apps"
                                     GroupName="NavTabs"
                                     Tag="Debloat"
                                     Click="TabButton_Click"
                                     Style="{StaticResource SegmentedTabStyle}"/>
                        <RadioButton Content="Settings &amp; Logs"
                                     GroupName="NavTabs"
                                     Tag="Settings"
                                     Click="TabButton_Click"
                                     Style="{StaticResource SegmentedTabStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Right Quick Utilities & Hardware Chassis Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Device Profile Toggle (Laptop vs Desktop) -->
                    <Border Background="{DynamicResource SegmentedTabBgBrush}" CornerRadius="8" Padding="2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="💻 Laptop"
                                         GroupName="DeviceChassisProfile"
                                         IsChecked="{Binding Metrics.IsUserLaptopMode}"
                                         Click="ChassisLaptop_Click"
                                         Style="{StaticResource SegmentedTabStyle}"
                                         Padding="10,4"
                                         FontSize="11"
                                         ToolTip="Enables battery saver optimizations and modern standby drain fixes"/>
                            <RadioButton Content="🖥️ Desktop"
                                         GroupName="DeviceChassisProfile"
                                         IsChecked="{Binding Metrics.IsUserLaptopMode, Converter={StaticResource InverseBooleanConverter}}"
                                         Click="ChassisDesktop_Click"
                                         Style="{StaticResource SegmentedTabStyle}"
                                         Padding="10,4"
                                         FontSize="11"
                                         ToolTip="Enables high-throughput gaming latency profiles"/>
                        </StackPanel>
                    </Border>

                    <!-- Restore Point Quick Action -->
                    <Button Content="Restore Point"
                            Click="CreateRestorePoint_Click"
                            Style="{StaticResource AppleSecondaryButton}"
                            Padding="12,6"
                            FontSize="12"
                            Margin="0,0,8,0"
                            ToolTip="Create an instant Windows System Restore Point"/>

                    <!-- Restart Explorer -->
                    <Button Content="Restart Explorer"
                            Click="RestartExplorer_Click"
                            Style="{StaticResource AppleSecondaryButton}"
                            Padding="12,6"
                            FontSize="12"
                            Margin="0,0,10,0"
                            ToolTip="Instantly restarts File Explorer to apply UI tweaks"/>

                    <!-- OS Badge -->
                    <Border Background="{DynamicResource PillBgBrush}"
                            CornerRadius="8"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SafeBadgeBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Metrics.OsName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Metrics.OsBuild}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== LIVE HARDWARE TELEMETRY BAR ==================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundBrush}"
                Padding="20,12,20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CPU LOAD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding Metrics.CpuUsage, StringFormat={}{0:F1}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="%" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,7,0,0"/>
                            <TextBlock Text="{Binding Metrics.CpuCores, StringFormat={} ({0} Cores)}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,9,0,0"/>
                        </StackPanel>
                        <ProgressBar Grid.Row="2"
                                     Value="{Binding Metrics.CpuUsage}"
                                     Maximum="100"
                                     Height="4"
                                     Style="{StaticResource MetricProgressStyle}"/>
                    </Grid>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="MEMORY (RAM)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Metrics.RamUsagePercent, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding Metrics.RamUsedGb, StringFormat={}{0:F1}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" / " FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,7,0,0"/>
                            <TextBlock Text="{Binding Metrics.RamTotalGb, StringFormat={}{0:F1} GB}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <ProgressBar Grid.Row="2"
                                     Value="{Binding Metrics.RamUsagePercent}"
                                     Maximum="100"
                                     Height="4"
                                     Style="{StaticResource MetricProgressStyle}"/>
                    </Grid>
                </Border>

                <!-- Storage & Procs Card -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="STORAGE &amp; PROCS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Metrics.DiskUsagePercent, StringFormat={}C: {0:F0}%}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding Metrics.ProcessCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" Procs • " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,7,0,0"/>
                            <TextBlock Text="{Binding Metrics.UptimeString}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <ProgressBar Grid.Row="2"
                                     Value="{Binding Metrics.DiskUsagePercent}"
                                     Maximum="100"
                                     Height="4"
                                     Style="{StaticResource MetricProgressStyle}"/>
                    </Grid>
                </Border>

                <!-- Device Mode & Optimization Score Card -->
                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="OPTIMIZED INDEX" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Metrics.OptimizationScore, StringFormat={}{0}%}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding Metrics.TotalAppliedTweaks}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SafeBadgeBrush}"/>
                            <TextBlock Text=" of " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,7,0,0"/>
                            <TextBlock Text="{Binding Metrics.TotalAvailableTweaks}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                            <TextBlock Text=" Active" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,7,0,0"/>
                        </StackPanel>
                        <ProgressBar Grid.Row="2"
                                     Value="{Binding Metrics.OptimizationScore}"
                                     Maximum="100"
                                     Height="4"
                                     Style="{StaticResource MetricProgressStyle}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT TABS ==================== -->
        <Grid Grid.Row="2" Margin="20,6,20,14">

            <!-- TAB 1: DASHBOARD -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Dashboard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- System Safety Shield Banner -->
                        <Border Style="{StaticResource AppleCardStyle}" Padding="20,16" Margin="0,0,0,14" Background="{DynamicResource CardBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🛡️ System Safety Shield &amp; Optimization Checklist" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Metrics.IsRestorePointCreated}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SafeBadgeBgBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Metrics.IsRestorePointCreated}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource CautionBadgeBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Metrics.IsRestorePointCreated}" Value="True">
                                                                <Setter Property="Text" Value="RESTORE POINT ACTIVE"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SafeBadgeBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Metrics.IsRestorePointCreated}" Value="False">
                                                                <Setter Property="Text" Value="RESTORE POINT RECOMMENDED"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource CautionBadgeBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Every tweak is labeled with risk levels: 🟢 Safe (100% reversible, zero side effects), 🟡 50/50 Caution (disables secondary features like GameDVR or Indexing), and 🔴 Risky (for competitive gaming). Always create a Restore Point before applying major changes."
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Create Restore Point"
                                        Click="CreateRestorePoint_Click"
                                        Style="{StaticResource AppleSecondaryButton}"
                                        Padding="16,8"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Smart Hardware Audit Card -->
                        <Border Style="{StaticResource AppleCardStyle}" Padding="20,16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="⚡ Zenith Smart Hardware Audit Engine" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Analyzes your CPU cores, RAM capacity, SSD/NVMe storage, and device chassis to calculate the optimal tweaks." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Content="Run Smart Audit &amp; Select Best Tweaks"
                                            Click="RunSmartAudit_Click"
                                            Style="{StaticResource AppleButton}"
                                            Padding="18,8"
                                            HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Audit Summary Box -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource SegmentedTabBgBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Metrics.SmartAuditSummary}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                               TextWrapping="Wrap"
                                               LineHeight="16"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Presets Section Header -->
                        <TextBlock Text="ONE-CLICK OPTIMIZATION PRESETS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,10"/>

                        <!-- 4 Presets Grid -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Preset 1: Safe Default -->
                            <Border Grid.Column="0" Style="{StaticResource AppleCardStyle}" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource SafeBadgeBgBrush}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SafeBadgeBrush}"/>
                                        </Border>
                                        <TextBlock Text="Recommended" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,14">
                                        <TextBlock Text="Safe Productivity" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Disables telemetry, error reporting, bloatware autoinstall, lock screen ads, and background indexing delay."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="2"
                                            Content="Load Safe Preset"
                                            Click="PresetSafe_Click"
                                            Style="{StaticResource AppleButton}"/>
                                </Grid>
                            </Border>

                            <!-- Preset 2: Laptop Battery -->
                            <Border Grid.Column="1" Style="{StaticResource AppleCardStyle}" Margin="6,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource SafeBadgeBgBrush}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="LAPTOP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SafeBadgeBrush}"/>
                                        </Border>
                                        <TextBlock Text="Battery Saver" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,14">
                                        <TextBlock Text="Laptop Efficiency" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Fixes Modern Standby sleep drain, prevents WiFi power droop on battery, and suspends high-CPU telemetry daemons."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="2"
                                            Content="Load Laptop Preset"
                                            Click="PresetLaptop_Click"
                                            Style="{StaticResource AppleButton}"/>
                                </Grid>
                            </Border>

                            <!-- Preset 3: Pro Gaming -->
                            <Border Grid.Column="2" Style="{StaticResource AppleCardStyle}" Margin="6,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource CautionBadgeBgBrush}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="50/50" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CautionBadgeBrush}"/>
                                        </Border>
                                        <TextBlock Text="Gaming Latency" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,14">
                                        <TextBlock Text="Pro Gaming Latency" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Eliminates GameDVR micro-stutter, optimizes MMCSS network packets, enforces 1:1 raw mouse tracking, and disables SysMain."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="2"
                                            Content="Load Gaming Preset"
                                            Click="PresetGaming_Click"
                                            Style="{StaticResource AppleButton}"/>
                                </Grid>
                            </Border>

                            <!-- Preset 4: Revert All -->
                            <Border Grid.Column="3" Style="{StaticResource AppleCardStyle}" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource PillBgBrush}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="STOCK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock Text="Rollback" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,14">
                                        <TextBlock Text="Revert to Defaults" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Restores Microsoft stock registry keys, enables default telemetry and standard background services safely."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="2"
                                            Content="Revert All Tweaks"
                                            Click="RevertAll_Click"
                                            Style="{StaticResource AppleSecondaryButton}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Quick Storage Reclaim Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource AppleCardStyle}" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Purge System Temp Caches &amp; Flush DNS" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Safely cleans Windows Temp, User Temp, Prefetch, and flushes network DNS cache." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Purge Now"
                                            Click="CleanTemp_Click"
                                            Style="{StaticResource AppleSecondaryButton}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource AppleCardStyle}" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Reclaim SSD Storage (Disable Hibernation)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Deletes hiberfil.sys to immediately free 8GB to 32GB of SSD disk space." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Free Storage"
                                            Click="FreeStorage_Click"
                                            Style="{StaticResource AppleSecondaryButton}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: UNIFIED TWEAKS (Auto-detects and hides incompatible OS tweaks) -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Tweaks}">
                <Grid.RowDefinitions>
                    <!-- Filter and Search Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Optimizations Card List -->
                    <RowDefinition Height="*"/>
                    <!-- Sticky Bottom Action Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filter Toolbar -->
                <Border Grid.Row="0"
                        Style="{StaticResource AppleCardStyle}"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Pills -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton Content="All Compatible"
                                         GroupName="RiskFilter"
                                         IsChecked="True"
                                         Tag="All"
                                         Click="RiskFilter_Click"
                                         Style="{StaticResource RiskFilterPillStyle}"/>
                            <RadioButton Content="🟢 Safe"
                                         GroupName="RiskFilter"
                                         Tag="Safe"
                                         Click="RiskFilter_Click"
                                         Style="{StaticResource RiskFilterPillStyle}"/>
                            <RadioButton Content="🟡 50/50 Caution"
                                         GroupName="RiskFilter"
                                         Tag="Caution"
                                         Click="RiskFilter_Click"
                                         Style="{StaticResource RiskFilterPillStyle}"/>
                            <RadioButton Content="🔴 Risky"
                                         GroupName="RiskFilter"
                                         Tag="Risky"
                                         Click="RiskFilter_Click"
                                         Style="{StaticResource RiskFilterPillStyle}"/>
                            <RadioButton Content="💻 Laptop Battery"
                                         GroupName="RiskFilter"
                                         Tag="Laptop"
                                         Click="RiskFilter_Click"
                                         Style="{StaticResource RiskFilterPillStyle}"/>
                            <RadioButton Content="🎯 Gaming"
                                         GroupName="RiskFilter"
                                         Tag="Gaming"
                                         Click="RiskFilter_Click"
                                         Style="{StaticResource RiskFilterPillStyle}"/>
                        </StackPanel>

                        <!-- Instant Search Box -->
                        <TextBox Grid.Column="2"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppleSearchBox}"
                                 ToolTip="Search tweaks by title, description, or keyword"/>
                    </Grid>
                </Border>

                <!-- Unified Tweaks List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredOptimizations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OptimizationItem}">
                                <Border Style="{StaticResource AppleCardStyle}" Margin="0,0,0,8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  Style="{StaticResource AppleCheckBox}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0"/>

                                        <!-- Tweak Information -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                <!-- Risk Badge -->
                                                <Border Background="{Binding Risk, Converter={StaticResource RiskToBgConverter}}"
                                                        CornerRadius="5"
                                                        Padding="6,2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RiskBadgeText}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskToColorConverter}}"/>
                                                </Border>

                                                <!-- Category Badge -->
                                                <Border Background="{DynamicResource PillBgBrush}"
                                                        CornerRadius="5"
                                                        Padding="6,2"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryBadgeText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>

                                                <!-- OS Tag Badge -->
                                                <Border Background="{DynamicResource PillBgBrush}"
                                                        CornerRadius="5"
                                                        Padding="6,2"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OsBadgeText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15"/>

                                            <!-- Tradeoff -->
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="Trade-off: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Tradeoff}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status Indicator & Quick Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <!-- Status Pill -->
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SafeBadgeBgBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsApplied}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource PillBgBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SafeBadgeBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsApplied}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Apply Single Button -->
                                            <Button Content="Apply"
                                                    Tag="{Binding}"
                                                    Click="ApplySingle_Click"
                                                    Style="{StaticResource AppleSecondaryButton}"
                                                    Padding="10,5"
                                                    FontSize="11"
                                                    Margin="0,0,6,0"/>

                                            <!-- Revert Single Button -->
                                            <Button Content="Revert"
                                                    Tag="{Binding}"
                                                    Click="RevertSingle_Click"
                                                    Style="{StaticResource AppleSecondaryButton}"
                                                    Padding="10,5"
                                                    FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Sticky Bottom Action Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bulk Selection buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Select All"
                                    Click="SelectAll_Click"
                                    Style="{StaticResource AppleSecondaryButton}"
                                    Padding="12,6"
                                    Margin="0,0,8,0"/>
                            <Button Content="Deselect All"
                                    Click="DeselectAll_Click"
                                    Style="{StaticResource AppleSecondaryButton}"
                                    Padding="12,6"/>
                        </StackPanel>

                        <!-- Execution Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Revert Selected"
                                    Click="RevertSelected_Click"
                                    Style="{StaticResource AppleSecondaryButton}"
                                    Padding="16,8"
                                    Margin="0,0,10,0"/>
                            <Button Content="Apply Selected"
                                    Click="ApplySelected_Click"
                                    Style="{StaticResource AppleButton}"
                                    Padding="20,8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 3: FRIENDLY DEBLOAT APPS -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Debloat}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Friendly Header Banner -->
                <Border Grid.Row="0" Style="{StaticResource AppleCardStyle}" Padding="18,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="🗑️ Friendly Windows App Debloater" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Safely uninstalls pre-installed consumer bloatware and sponsored store apps. Every app can be reinstalled from Microsoft Store at any time."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <!-- 3 Quick Selection Presets -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Select Recommended"
                                    Click="DebloatSelectRecommended_Click"
                                    Style="{StaticResource AppleSecondaryButton}"
                                    Padding="12,6"
                                    FontSize="11"
                                    Margin="0,0,6,0"/>
                            <Button Content="Select All"
                                    Click="DebloatSelectAll_Click"
                                    Style="{StaticResource AppleSecondaryButton}"
                                    Padding="12,6"
                                    FontSize="11"
                                    Margin="0,0,6,0"/>
                            <Button Content="Deselect All"
                                    Click="DebloatDeselectAll_Click"
                                    Style="{StaticResource AppleSecondaryButton}"
                                    Padding="12,6"
                                    FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Friendly Category Cards List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding BloatwareCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:FriendlyBloatCategory}">
                                <Border Style="{StaticResource AppleCardStyle}" Margin="0,0,0,8" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Checkbox -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Icon -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Details -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Safety Badge -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  Style="{StaticResource AppleCheckBox}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>

                                        <TextBlock Grid.Column="1" Text="{Binding IconSymbol}" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding ImpactDescription}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" FontStyle="Italic"/>
                                        </StackPanel>

                                        <Border Grid.Column="3"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RiskBadge}" Value="SAFE">
                                                            <Setter Property="Background" Value="{DynamicResource SafeBadgeBgBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskBadge}" Value="50/50 CAUTION">
                                                            <Setter Property="Background" Value="{DynamicResource CautionBadgeBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RiskBadge}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RiskBadge}" Value="SAFE">
                                                                <Setter Property="Foreground" Value="{DynamicResource SafeBadgeBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RiskBadge}" Value="50/50 CAUTION">
                                                                <Setter Property="Foreground" Value="{DynamicResource CautionBadgeBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Action Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Removes selected applications for all users to reclaim disk space and background RAM."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Uninstall Selected Apps"
                                Click="PurgeBloatware_Click"
                                Style="{StaticResource AppleButton}"
                                Padding="22,8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 4: SETTINGS & LOGS -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Themes Card -->
                        <Border Style="{StaticResource AppleCardStyle}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="APPEARANCE &amp; THEMES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <TextBlock Text="Theme" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Cupertino Dark"
                                                 GroupName="ThemeGroup"
                                                 IsChecked="True"
                                                 Tag="CupertinoDark"
                                                 Click="ThemeSelector_Click"
                                                 Style="{StaticResource RiskFilterPillStyle}"/>
                                    <RadioButton Content="Cupertino Light"
                                                 GroupName="ThemeGroup"
                                                 Tag="CupertinoLight"
                                                 Click="ThemeSelector_Click"
                                                 Style="{StaticResource RiskFilterPillStyle}"/>
                                    <RadioButton Content="Midnight Slate"
                                                 GroupName="ThemeGroup"
                                                 Tag="MidnightSlate"
                                                 Click="ThemeSelector_Click"
                                                 Style="{StaticResource RiskFilterPillStyle}"/>
                                    <RadioButton Content="Graphite Minimal"
                                                 GroupName="ThemeGroup"
                                                 Tag="GraphiteMinimal"
                                                 Click="ThemeSelector_Click"
                                                 Style="{StaticResource RiskFilterPillStyle}"/>
                                </StackPanel>

                                <TextBlock Text="Accent Highlight Color" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,14,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Zenith Purple"
                                                 GroupName="AccentGroup"
                                                 IsChecked="True"
                                                 Tag="RoyalViolet"
                                                 Click="AccentSelector_Click"
                                                 Style="{StaticResource RiskFilterPillStyle}"/>
                                    <RadioButton Content="Apple Blue"
                                                 GroupName="AccentGroup"
                                                 Tag="AppleBlue"
                                                 Click="AccentSelector_Click"
                                                 Style="{StaticResource RiskFilterPillStyle}"/>
                                    <RadioButton Content="Cyber Emerald"
                                                 GroupName="AccentGroup"
                                                 Tag="EmeraldGreen"
                                                 Click="AccentSelector_Click"
                                                 Style="{StaticResource RiskFilterPillStyle}"/>
                                    <RadioButton Content="Sunset Amber"
                                                 GroupName="AccentGroup"
                                                 Tag="SunsetAmber"
                                                 Click="AccentSelector_Click"
                                                 Style="{StaticResource RiskFilterPillStyle}"/>
                                    <RadioButton Content="Coral Crimson"
                                                 GroupName="AccentGroup"
                                                 Tag="CoralCrimson"
                                                 Click="AccentSelector_Click"
                                                 Style="{StaticResource RiskFilterPillStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Audit Log Details -->
                        <Border Style="{StaticResource AppleCardStyle}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="HARDWARE AUDIT DIAGNOSTIC SUMMARY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border Background="{DynamicResource SegmentedTabBgBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Metrics.SmartAuditSummary}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                               TextWrapping="Wrap"
                                               LineHeight="16"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Execution Logs -->
                        <Border Style="{StaticResource AppleCardStyle}" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="EXECUTION DIAGNOSTIC LOGS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button Content="Clear Logs"
                                            Click="ClearLogs_Click"
                                            Style="{StaticResource AppleSecondaryButton}"
                                            Padding="8,4"
                                            FontSize="11"
                                            HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Background="{DynamicResource SegmentedTabBgBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Height="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox Text="{Binding StatusLog, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 BorderThickness="0"
                                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                                 FontSize="11"
                                                 TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ==================== BUSY / SMOOTH ANIMATED PROGRESS BAR OVERLAY ==================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status Header: Operation, Step Count (e.g. 1/8) & Percentage -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Purple Pulse Dot & Active Operation -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#9333EA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentOperationTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Step Count (e.g. 1/8) & Percentage -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentBrushLight}" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ProgressStepText}"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding ProgressPercentageText}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Progress Bar: Smooth Purple Slider -->
                <ProgressBar Grid.Row="1"
                             x:Name="AnimatedProgressSlider"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Style="{StaticResource SmoothPurpleProgressBarStyle}"/>
            </Grid>
        </Border>

        <!-- ==================== EXECUTION RESULT & ERROR BANNER ==================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12"
                Visibility="{Binding ShowResultBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Icon Badge (Green Check or Amber/Red Warning) -->
                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="16"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2010B981"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasExecutionErrors}" Value="True">
                                    <Setter Property="Background" Value="#25EF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="✔"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasExecutionErrors}" Value="True">
                                        <Setter Property="Text" Value="⚠"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Content & Failure Breakdown -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultBannerTitle}"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding ResultBannerMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>

                    <!-- Failed Items Detail List -->
                    <ItemsControl ItemsSource="{Binding ExecutionErrors}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#15EF4444" BorderBrush="#30EF4444" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#F87171" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Action Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Dismiss"
                            Padding="12,6"
                            Click="DismissBanner_Click"
                            Style="{StaticResource AppleSecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
